# Copy to .env for local development and set in Vercel Project -> Settings -> Environment Variables
GROQ_API_KEY=
APP_PASSWORD=change-me
# Optional: set a random secret for signing auth cookies (falls back to derived key if omitted)
AUTH_SECRET=
# Optional: Fish Audio TTS for Norwegian voice prompts & feedback
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro
